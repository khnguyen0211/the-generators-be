# =============================================================
# The Generators - Environment Configuration Template
# =============================================================
# Copy this file to .env.dev, .env.staging, or .env.prod
# and fill in the actual values.
# =============================================================

# Environment: dev | staging | prod
APP_ENV=

# ===== AI PROVIDER API KEYS =====
OPENAI_API_KEY=
REPLICATE_API_KEY=
STABILITY_API_KEY=

# ===== TEXT TO IMAGE =====
TEXT_TO_IMAGE_DEFAULT=
TEXT_TO_IMAGE_MODELS=

# OpenAI DALL-E
TEXT_TO_IMAGE_OPENAI_MODEL=
TEXT_TO_IMAGE_OPENAI_SIZE=
TEXT_TO_IMAGE_OPENAI_QUALITY=

# Replicate (Flux Pro)
TEXT_TO_IMAGE_REPLICATE_MODEL=

# Stability AI
TEXT_TO_IMAGE_STABILITY_MODEL=

# ===== TEXT TO VIDEO =====
TEXT_TO_VIDEO_DEFAULT=
TEXT_TO_VIDEO_MODELS=

# Replicate (Minimax)
TEXT_TO_VIDEO_REPLICATE_MODEL=

# ===== TEXT TO SPEECH =====
TEXT_TO_SPEECH_DEFAULT=
TEXT_TO_SPEECH_MODELS=

# OpenAI TTS
TEXT_TO_SPEECH_OPENAI_MODEL=
TEXT_TO_SPEECH_OPENAI_VOICE=

# ElevenLabs
TEXT_TO_SPEECH_ELEVENLABS_MODEL=
TEXT_TO_SPEECH_ELEVENLABS_VOICE_ID=

# ===== IMAGE TO VIDEO =====
IMAGE_TO_VIDEO_DEFAULT=
IMAGE_TO_VIDEO_MODELS=

# Replicate
IMAGE_TO_VIDEO_REPLICATE_MODEL=

# ===== SERVER =====
FLASK_PORT=
FLASK_DEBUG=
OUTPUT_DIR=

# ===== REDIS =====
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# ===== DATABASE (PostgreSQL) =====
# Connection parameters for PostgreSQL database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== LOGGING =====
LOG_DIR=
LOG_LEVEL=

# ===== FRONTEND =====
# Dev: http://localhost:5000
# Prod: https://your-domain.com
API_BASE_URL=
